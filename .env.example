# ==============================================================================
# MediLocate AI - Environment Variable Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in your local environment when implementation begins:
#    cp .env.example .env
# 2. Fill in the placeholder values with your local/development secrets.
# 3. NEVER commit the actual '.env' file or any real secrets to version control!
# 4. NEVER expose service-role keys, database passwords, or Django secret keys to the frontend!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# Django secret key used for cryptographic signing. Generate a secure random string for development.
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-min-50-chars

# Debug mode: Set to True for local development, False for production.
DJANGO_DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Backend server binding port (default: 8000)
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 2. SUPABASE & POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Supabase project URL (found in Supabase Project Settings -> API)
# Example: https://xyzcompanyproject.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (safe to use on client-side requests where authorized)
SUPABASE_ANON_KEY=your-supabase-anon-public-key-placeholder

# Direct PostgreSQL connection parameters for Django ORM
# Host URL from Supabase Database settings (e.g., db.xxxxxx.supabase.co or aws-0-region.pooler.supabase.com)
SUPABASE_DB_HOST=db.your-project-id.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password-placeholder

# Full Database URL (convenience connection string format for dj-database-url)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:your-supabase-db-password-placeholder@db.your-project-id.supabase.co:5432/postgres

# NOTE: Supabase service_role keys bypass Row Level Security.
# NEVER place service_role keys in frontend code, client bundles, or standard API responses!

# ------------------------------------------------------------------------------
# 3. FRONTEND CONFIGURATION (Vite / React)
# ------------------------------------------------------------------------------
# Base URL for the Django REST Framework backend API consumed by frontend services.
# In local development, DRF typically runs on http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 4. CORS & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of origins authorized to make cross-origin HTTP requests to the Django backend.
# In local development, Vite typically serves on http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
